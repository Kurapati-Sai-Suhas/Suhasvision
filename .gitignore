# Python & Backend
venv/
__pycache__/
*.sqlite3
backend/backend/.env

# AI Keys & Secrets (CRITICAL)
.env
dataset/.env

# Node & Frontend (Just in case the nested one misses it)
node_modules/
dist/
.DS_Store
# Media
backend/backend/media/
*.log

# Dataset: track the ML source code, ignore the heavy generated/raw data.
# (Previously the whole dataset/ folder was ignored, which meant
# inference_service.py, zero_storage_pipeline.py, schema.py, and the .keras
# models had no version control at all.)
dataset/raw_videos/
dataset/frames/
dataset/frames_annotated/
dataset/diversity_report/
dataset/*.csv
dataset/*.mp4
dataset/*.log
dataset/*.txt
dataset/__pycache__/
dataset/academic_scripts/__pycache__/
dataset/cookies.txt
dataset/*.bak*
# Large model/asset binaries — consider Git LFS for these instead of raw commits.
dataset/*.keras
dataset/*.task


# ---------------------------------------------------------------------------
# Phase 2/3 extraction work
# ---------------------------------------------------------------------------
# Detector weights: ~193 MB, downloaded on first use by ultralytics. Pinned by
# name in phase2_detectors.py, so they are reproducible without being stored.
*.pt

# Contact sheets and filmstrips: ~112 MB of JPEGs. They are regenerable from
# the committed scripts, and they are review artifacts rather than evidence —
# the numbers derived from them live in the committed JSON/JSONL.
dataset/phase2_results/annotation_sheets/
dataset/phase2_results/phase2_sheets/
dataset/phase3_results/event_sheets/
dataset/experiment_results/sheets_A0/
dataset/experiment_results/sheets_A3/

# Stray diagnostics written by test runs into the module's default path.
dataset/extraction_diagnostics.jsonl
dataset/phase3_results/batsman_audit_sheets/
dataset/phase3_results/pose_audit_sheets/

# Shot-localization timeline diagrams: regenerable from phase3_shot_analysis.py.
dataset/phase3_results/shot_timeline_*.png

# Best-7 / shot audit timelines: regenerable from the phase3 audit scripts.
dataset/phase3_results/best7_timeline_*.png

# Per-frame event cache (~2.3MB): regenerable from phase3_event_cache.py, and
# an intermediate rather than evidence - the results JSONs carry the findings.
dataset/phase3_results/phase3_event_cache.json

# Blind annotation sheets: regenerable, and large. The subset manifest and
# answer template ARE committed.
dataset/phase3_results/blind_sheets/
